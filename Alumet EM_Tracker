import { useState, useEffect } from 'react';

export default function App() {
    const [employees, setEmployees] = useState([]);
    const [view, setView] = useState('list');
    const [searchTerm, setSearchTerm] = useState('');
    const [editingId, setEditingId] = useState(null);
    const [formData, setFormData] = useState({
        employeeId: '',
        name: '',
        department: '',
        position: '',
        workStartDate: '',
        address: ''
    });

    useEffect(() => {
        const loadData = async () => {
            try {
                const result = await window.storage.get('employees_data');
                if (result && result.value) {
                    setEmployees(JSON.parse(result.value));
                }
            } catch (error) {
                console.log('No data found');
            }
        };
        loadData();
    }, []);

    useEffect(() => {
        if (employees.length > 0) {
            window.storage.set('employees_data', JSON.stringify(employees)).catch(err => {
                console.error('Storage error:', err);
            });
        }
    }, [employees]);

    const calculateDuration = (startDate) => {
        const start = new Date(startDate);
        const now = new Date();
        const diffTime = Math.abs(now - start);
        const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
        
        const years = Math.floor(diffDays / 365);
        const months = Math.floor((diffDays % 365) / 30);
        const days = diffDays % 30;
        
        let result = [];
        if (years > 0) result.push(`${years} ปี`);
        if (months > 0) result.push(`${months} เดือน`);
        if (days > 0 || result.length === 0) result.push(`${days} วัน`);
        
        return result.join(' ');
    };

    const handleSubmit = () => {
        if (!formData.employeeId || !formData.name || !formData.department || 
            !formData.position || !formData.workStartDate) {
            alert('กรุณากรอกข้อมูลให้ครบถ้วน');
            return;
        }

        if (editingId === null) {
            if (!formData.address) {
                alert('กรุณากรอกที่อยู่');
                return;
            }
            if (employees.some(emp => emp.employeeId === formData.employeeId.trim())) {
                alert('รหัสพนักงานนี้มีในระบบแล้ว');
                return;
            }
        }
        
        const currentDate = new Date().toISOString();
        
        if (editingId !== null) {
            setEmployees(employees.map(emp => {
                if (emp.id === editingId) {
                    return {
                        ...emp,
                        name: formData.name,
                        department: formData.department,
                        position: formData.position,
                        workStartDate: formData.workStartDate
                    };
                }
                return emp;
            }));
        } else {
            const newEmp = {
                id: Date.now(),
                employeeId: formData.employeeId.trim(),
                name: formData.name,
                department: formData.department,
                position: formData.position,
                workStartDate: formData.workStartDate,
                currentAddress: {
                    address: formData.address,
                    startDate: currentDate
                },
                addressHistory: [{
                    address: formData.address,
                    startDate: currentDate
                }]
            };
            setEmployees([...employees, newEmp]);
        }
        
        setFormData({
            employeeId: '',
            name: '',
            department: '',
            position: '',
            workStartDate: '',
            address: ''
        });
        setEditingId(null);
        setView('list');
    };

    const deleteEmployee = (id) => {
        if(window.confirm('ยืนยันการลบข้อมูล?')) {
            setEmployees(employees.filter(emp => emp.id !== id));
        }
    };

    const updateAddress = (id) => {
        const newAddress = window.prompt('ที่อยู่ใหม่:');
        if (newAddress && newAddress.trim()) {
            setEmployees(employees.map(emp => {
                if (emp.id === id) {
                    const currentDate = new Date().toISOString();
                    const newAddressObj = {
                        address: newAddress.trim(),
                        startDate: currentDate
                    };
                    return {
                        ...emp,
                        currentAddress: newAddressObj,
                        addressHistory: [...emp.addressHistory, newAddressObj]
                    };
                }
                return emp;
            }));
        }
    };

    const editEmployee = (emp) => {
        setEditingId(emp.id);
        setFormData({
            employeeId: emp.employeeId,
            name: emp.name,
            department: emp.department,
            position: emp.position,
            workStartDate: emp.workStartDate,
            address: ''
        });
        setView('add');
    };

    const filteredEmployees = employees.filter(emp => {
        const search = searchTerm.toLowerCase();
        return emp.employeeId.toLowerCase().includes(search) ||
               emp.name.toLowerCase().includes(search) ||
               emp.department.toLowerCase().includes(search) ||
               emp.position.toLowerCase().includes(search);
    });

    const getDepartmentStats = () => {
        if (employees.length === 0) return [];
        const deptCount = {};
        employees.forEach(emp => {
            deptCount[emp.department] = (deptCount[emp.department] || 0) + 1;
        });
        return Object.entries(deptCount).map(([dept, count]) => ({
            name: dept,
            count,
            percentage: ((count / employees.length) * 100).toFixed(1)
        }));
    };

    const getAddressStats = () => {
        if (employees.length === 0) return [];
        const addressCount = {};
        employees.forEach(emp => {
            const addr = emp.currentAddress.address;
            addressCount[addr] = (addressCount[addr] || 0) + 1;
        });
        return Object.entries(addressCount).map(([addr, count]) => ({
            name: addr.length > 30 ? addr.substring(0, 30) + '...' : addr,
            fullName: addr,
            count,
            percentage: ((count / employees.length) * 100).toFixed(1)
        }));
    };

    return (
        <div className="w-full min-h-screen pb-20 bg-slate-50">
            <div className="max-w-6xl mx-auto">
                <header className="bg-gradient-to-r from-blue-600 to-blue-700 text-white p-4 sticky top-0 shadow-lg z-10">
                    <h1 className="text-xl font-bold text-center">📍 ระบบติดตามที่อยู่พนักงาน</h1>
                </header>

                {view === 'list' && (
                    <div className="p-4">
                        <div className="mb-4">
                            <input 
                                type="text"
                                placeholder="🔍 ค้นหา รหัส ชื่อ แผนก ตำแหน่ง"
                                className="w-full p-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 outline-none"
                                value={searchTerm}
                                onChange={(e) => setSearchTerm(e.target.value)}
                            />
                        </div>

                        <div className="flex justify-between items-center mb-4">
                            <h2 className="font-bold text-gray-700">รายชื่อพนักงาน ({filteredEmployees.length}/{employees.length})</h2>
                            <div className="flex gap-2">
                                <button 
                                    onClick={() => setView('chart')} 
                                    className="bg-purple-500 text-white px-3 py-2 rounded-full text-sm hover:bg-purple-600"
                                >
                                    📊 สถิติ
                                </button>
                                <button 
                                    onClick={() => { 
                                        setEditingId(null); 
                                        setFormData({
                                            employeeId: '', name: '', department: '', 
                                            position: '', workStartDate: '', address: ''
                                        });
                                        setView('add'); 
                                    }} 
                                    className="bg-green-500 text-white px-3 py-2 rounded-full text-sm hover:bg-green-600"
                                >
                                    ➕ เพิ่ม
                                </button>
                            </div>
                        </div>

                        {filteredEmployees.length === 0 ? (
                            <div className="text-center py-10 text-gray-400">
                                {searchTerm ? 'ไม่พบข้อมูลที่ค้นหา' : 'ยังไม่มีข้อมูลพนักงาน'}
                            </div>
                        ) : (
                            <div className="grid md:grid-cols-2 gap-4">
                                {filteredEmployees.map(emp => (
                                    <div key={emp.id} className="bg-white p-4 rounded-xl shadow-md border-l-4 border-blue-500">
                                        <div className="flex justify-between items-start mb-3">
                                            <div className="flex-1">
                                                <div className="text-xs text-gray-500">รหัส: {emp.employeeId}</div>
                                                <div className="font-bold text-lg text-blue-800">{emp.name}</div>
                                                <div className="text-sm text-gray-600">
                                                    🏢 {emp.department} | {emp.position}
                                                </div>
                                            </div>
                                            <div className="flex gap-2">
                                                <button 
                                                    onClick={() => editEmployee(emp)} 
                                                    className="text-blue-500 hover:text-blue-700 text-lg"
                                                >
                                                    ✏️
                                                </button>
                                                <button 
                                                    onClick={() => deleteEmployee(emp.id)} 
                                                    className="text-red-400 hover:text-red-600 text-lg"
                                                >
                                                    🗑️
                                                </button>
                                            </div>
                                        </div>
                                        
                                        <div className="text-xs text-gray-500 mb-2">
                                            💼 อายุงาน: {calculateDuration(emp.workStartDate)}
                                        </div>
                                        
                                        <div className="bg-gray-50 p-3 rounded-lg mb-2">
                                            <div className="flex justify-between items-start gap-2">
                                                <div className="flex-1">
                                                    <div className="text-xs text-gray-500 mb-1">ที่อยู่ปัจจุบัน:</div>
                                                    <div className="text-sm text-gray-700">
                                                        📍 {emp.currentAddress.address}
                                                    </div>
                                                    <div className="text-xs text-gray-400 mt-1">
                                                        อยู่มาแล้ว: {calculateDuration(emp.currentAddress.startDate)}
                                                    </div>
                                                </div>
                                                <button 
                                                    onClick={() => updateAddress(emp.id)}
                                                    className="text-xs bg-blue-100 text-blue-600 px-2 py-1 rounded hover:bg-blue-200 whitespace-nowrap"
                                                >
                                                    ✏️ เปลี่ยน
                                                </button>
                                            </div>
                                        </div>
                                        
                                        {emp.addressHistory.length > 1 && (
                                            <details className="text-xs">
                                                <summary className="cursor-pointer text-blue-600 hover:text-blue-800">
                                                    ประวัติที่อยู่ ({emp.addressHistory.length} ครั้ง)
                                                </summary>
                                                <div className="mt-2 space-y-2 pl-4">
                                                    {emp.addressHistory.slice().reverse().map((addr, idx) => (
                                                        <div key={idx} className="border-l-2 border-gray-300 pl-3">
                                                            <div className="text-gray-700">{addr.address}</div>
                                                            <div className="text-gray-400">
                                                                {new Date(addr.startDate).toLocaleDateString('th-TH')}
                                                            </div>
                                                        </div>
                                                    ))}
                                                </div>
                                            </details>
                                        )}
                                    </div>
                                ))}
                            </div>
                        )}
                    </div>
                )}

                {view === 'chart' && (
                    <div className="p-4">
                        <button 
                            onClick={() => setView('list')} 
                            className="mb-4 text-blue-600 hover:text-blue-800 font-medium"
                        >
                            ← กลับ
                        </button>
                        
                        <div className="space-y-6">
                            <div className="bg-white p-6 rounded-2xl shadow-lg">
                                <h2 className="text-xl font-bold mb-4 text-gray-800">
                                    🏢 สถิติตามแผนก
                                </h2>
                                {getDepartmentStats().length === 0 ? (
                                    <div className="text-center text-gray-400 py-4">ยังไม่มีข้อมูล</div>
                                ) : (
                                    getDepartmentStats().map((dept, idx) => (
                                        <div key={idx} className="mb-4">
                                            <div className="flex justify-between mb-1">
                                                <span className="text-sm font-medium">{dept.name}</span>
                                                <span className="text-sm text-gray-600">{dept.count} คน ({dept.percentage}%)</span>
                                            </div>
                                            <div className="w-full bg-gray-200 rounded-full h-8 overflow-hidden">
                                                <div 
                                                    className="bg-gradient-to-r from-blue-500 to-blue-600 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold transition-all duration-500"
                                                    style={{width: `${Math.max(parseFloat(dept.percentage), 10)}%`}}
                                                >
                                                    {dept.percentage}%
                                                </div>
                                            </div>
                                        </div>
                                    ))
                                )}
                            </div>

                            <div className="bg-white p-6 rounded-2xl shadow-lg">
                                <h2 className="text-xl font-bold mb-4 text-gray-800">
                                    📍 สถิติตามที่อยู่
                                </h2>
                                {getAddressStats().length === 0 ? (
                                    <div className="text-center text-gray-400 py-4">ยังไม่มีข้อมูล</div>
                                ) : (
                                    getAddressStats().map((addr, idx) => (
                                        <div key={idx} className="mb-4">
                                            <div className="flex justify-between mb-1">
                                                <span className="text-sm font-medium" title={addr.fullName}>{addr.name}</span>
                                                <span className="text-sm text-gray-600">{addr.count} คน ({addr.percentage}%)</span>
                                            </div>
                                            <div className="w-full bg-gray-200 rounded-full h-8 overflow-hidden">
                                                <div 
                                                    className="bg-gradient-to-r from-red-500 to-red-600 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold transition-all duration-500"
                                                    style={{width: `${Math.max(parseFloat(addr.percentage), 10)}%`}}
                                                >
                                                    {addr.percentage}%
                                                </div>
                                            </div>
                                        </div>
                                    ))
                                )}
                            </div>

                            <div className="bg-gradient-to-r from-purple-500 to-purple-600 p-6 rounded-2xl shadow-lg text-white">
                                <h2 className="text-xl font-bold mb-4">
                                    📊 สรุปภาพรวม
                                </h2>
                                <div className="grid grid-cols-2 gap-4">
                                    <div className="bg-white bg-opacity-20 p-4 rounded-xl backdrop-blur-sm">
                                        <div className="text-3xl font-bold">{employees.length}</div>
                                        <div className="text-sm">พนักงานทั้งหมด</div>
                                    </div>
                                    <div className="bg-white bg-opacity-20 p-4 rounded-xl backdrop-blur-sm">
                                        <div className="text-3xl font-bold">{getDepartmentStats().length}</div>
                                        <div className="text-sm">แผนกทั้งหมด</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                )}

                {view === 'add' && (
                    <div className="p-4">
                        <button 
                            onClick={() => { 
                                setView('list'); 
                                setEditingId(null); 
                            }} 
                            className="mb-4 text-blue-600 hover:text-blue-800 font-medium"
                        >
                            ← กลับ
                        </button>
                        <div className="bg-white p-6 rounded-2xl shadow-lg">
                            <h2 className="text-lg font-bold mb-4">
                                {editingId ? '✏️ แก้ไขข้อมูลพนักงาน' : '➕ เพิ่มข้อมูลพนักงาน'}
                            </h2>
                            
                            <div className="mb-4">
                                <label className="block text-sm font-medium mb-2">รหัสพนักงาน *</label>
                                <input 
                                    type="text"
                                    value={formData.employeeId}
                                    onChange={(e) => setFormData({...formData, employeeId: e.target.value})}
                                    disabled={editingId !== null}
                                    className={`w-full border-2 p-3 rounded-lg ${editingId ? 'bg-gray-100 cursor-not-allowed' : 'bg-gray-50'}`}
                                    placeholder="เช่น EMP001" 
                                />
                                {editingId && <div className="text-xs text-gray-500 mt-1">ไม่สามารถแก้ไขรหัสพนักงานได้</div>}
                            </div>

                            <div className="mb-4">
                                <label className="block text-sm font-medium mb-2">ชื่อ-นามสกุล *</label>
                                <input 
                                    type="text"
                                    value={formData.name}
                                    onChange={(e) => setFormData({...formData, name: e.target.value})}
                                    className="w-full border-2 p-3 rounded-lg bg-gray-50 focus:border-blue-500 outline-none" 
                                    placeholder="ระบุชื่อพนักงาน" 
                                />
                            </div>

                            <div className="grid md:grid-cols-2 gap-4 mb-4">
                                <div>
                                    <label className="block text-sm font-medium mb-2">แผนก *</label>
                                    <input 
                                        type="text"
                                        value={formData.department}
                                        onChange={(e) => setFormData({...formData, department: e.target.value})}
                                        className="w-full border-2 p-3 rounded-lg bg-gray-50 focus:border-blue-500 outline-none" 
                                        placeholder="เช่น ฝ่ายผลิต" 
                                    />
                                </div>
                                <div>
                                    <label className="block text-sm font-medium mb-2">ตำแหน่ง *</label>
                                    <input 
                                        type="text"
                                        value={formData.position}
                                        onChange={(e) => setFormData({...formData, position: e.target.value})}
                                        className="w-full border-2 p-3 rounded-lg bg-gray-50 focus:border-blue-500 outline-none" 
                                        placeholder="เช่น พนักงานประจำ" 
                                    />
                                </div>
                            </div>

                            <div className="mb-4">
                                <label className="block text-sm font-medium mb-2">วันที่เริ่มงาน *</label>
                                <input 
                                    type="date"
                                    value={formData.workStartDate}
                                    onChange={(e) => setFormData({...formData, workStartDate: e.target.value})}
                                    className="w-full border-2 p-3 rounded-lg bg-gray-50 focus:border-blue-500 outline-none"
                                    max={new Date().toISOString().split('T')[0]}
                                />
                            </div>

                            {editingId === null && (
                                <div className="mb-4">
                                    <label className="block text-sm font-medium mb-2">ที่อยู่ปัจจุบัน *</label>
                                    <textarea 
                                        value={formData.address}
                                        onChange={(e) => setFormData({...formData, address: e.target.value})}
                                        className="w-full border-2 p-3 rounded-lg bg-gray-50 focus:border-blue-500 outline-none" 
                                        rows={3}
                                        placeholder="บ้านเลขที่ ถนน แขวง เขต จังหวัด รหัสไปรษณีย์"
                                    />
                                </div>
                            )}

                            <button 
                                onClick={handleSubmit}
                                className="w-full bg-gradient-to-r from-blue-600 to-blue-700 text-white py-3 rounded-xl font-bold hover:from-blue-700 hover:to-blue-800 transition-all"
                            >
                                💾 {editingId ? 'บันทึกการแก้ไข' : 'บันทึกข้อมูล'}
                            </button>
                        </div>
                    </div>
                )}

                <nav className="fixed bottom-0 left-0 right-0 bg-white border-t flex justify-around p-3 shadow-lg">
                    <button 
                        onClick={() => setView('list')} 
                        className={`flex flex-col items-center transition-colors ${view === 'list' ? 'text-blue-600' : 'text-gray-400'}`}
                    >
                        <span className="text-2xl">👥</span>
                        <span className="text-xs mt-1">พนักงาน</span>
                    </button>
                    <button 
                        onClick={() => setView('chart')} 
                        className={`flex flex-col items-center transition-colors ${view === 'chart' ? 'text-blue-600' : 'text-gray-400'}`}
                    >
                        <span className="text-2xl">📊</span>
                        <span className="text-xs mt-1">สถิติ</span>
                    </button>
                    <button 
                        onClick={() => { 
                            setEditingId(null); 
                            setFormData({
                                employeeId: '', name: '', department: '', 
                                position: '', workStartDate: '', address: ''
                            });
                            setView('add'); 
                        }} 
                        className={`flex flex-col items-center transition-colors ${view === 'add' ? 'text-blue-600' : 'text-gray-400'}`}
                    >
                        <span className="text-2xl">➕</span>
                        <span className="text-xs mt-1">เพิ่ม</span>
                    </button>
                </nav>
            </div>
        </div>
    );
}
